{
  "name": "spectra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs",
